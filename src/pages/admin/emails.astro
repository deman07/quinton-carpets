---
import Base from "../../layouts/Base.astro";
import AdminNav from "../../components/AdminNav.astro";
import { TEMPLATES, SAMPLE_BOOKING, type TemplateName } from "../../lib/email-templates.ts";
import { sendTest, siteContext } from "../../lib/server/email.ts";
import { getEnv } from "../../lib/server/env.ts";

// Every email the site sends, drawn with made-up booking details, so
// the shop can see exactly what customers get , and send one to
// themselves to check it on a phone.
//
// One email at a time, picked from the list (?t=name, so it works
// without JavaScript), shown at desktop or phone width (?w=phone), as
// HTML or as the plain-text copy (?v=text).
export const prerender = false;
Astro.response.headers.set("cache-control", "no-store");

const ctx = await siteContext();
const names = Object.keys(TEMPLATES) as TemplateName[];
const canSend = Boolean(getEnv().RESEND_API_KEY);

const q = Astro.url.searchParams;
const current: TemplateName = names.includes(q.get("t") as TemplateName) ? (q.get("t") as TemplateName) : names[0]!;
const width = q.get("w") === "phone" ? "phone" : "desktop";
const view = q.get("v") === "text" ? "text" : "html";

let result = "";
let resultOk = false;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const to = String(form.get("to") ?? "").trim().slice(0, 200);
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(to)) result = "That doesn't look like an email address.";
  else {
    const sent = await sendTest(to, (c) => TEMPLATES[current].render(c, SAMPLE_BOOKING));
    resultOk = sent.sent;
    result = sent.sent ? `Sent “${TEMPLATES[current].label}” to ${to}.` : `Not sent: ${sent.reason}`;
  }
}

const mail = TEMPLATES[current].render(ctx, SAMPLE_BOOKING);

/** This page with some of its choices changed. */
const link = (changes: Record<string, string | null>) => {
  const u = new URLSearchParams({ t: current, w: width, v: view });
  for (const [k, v] of Object.entries(changes)) {
    if (v === null) u.delete(k);
    else u.set(k, v);
  }
  if (u.get("w") === "desktop") u.delete("w");
  if (u.get("v") === "html") u.delete("v");
  return `/admin/emails/?${u}`;
};

// When each one goes out, in the shop's words.
const WHEN: Record<TemplateName, string> = {
  confirmation: "The moment a customer books on the website. Comes with a calendar file for their phone.",
  shop: "To the shop's inbox, at the same moment. Reply to it to write to the customer.",
  reminder: "Automatically, the afternoon before the visit, for bookings still new or called.",
  rescheduled: "When you move a booking in the diary with “Email the customer” ticked.",
  cancelled: "When you cancel a booking in the diary with “Email the customer” ticked.",
  thanks: "When you mark a job fitted and choose to send it, or press the button afterwards.",
};
---

<Base title="Emails , Quinton Carpets diary" description="Email previews." noindex>
  <div class="section plain admin">
    <div class="wrap" style="max-width:1180px">
      <AdminNav current="emails" />
      <h1 class="adminh1">The emails customers get</h1>
      <p class="hint" style="margin:-8px 0 18px">Drawn with made-up booking details. Pick one to see it.</p>

      {!canSend && (
        <p class="notice warn" style="margin-bottom:18px">
          No RESEND_API_KEY is set, so no email is actually sent yet , bookings still save. Add the key in
          Vercel to switch them on.
        </p>
      )}

      <div class="mailviewer">
        <nav class="maillist" aria-label="Emails">
          {names.map((n) => (
            <a href={link({ t: n })} aria-current={n === current ? "page" : undefined}>
              <b>{TEMPLATES[n].label.replace(/ \((customer|shop)\)$/, "")}</b>
              <span>{/\(shop\)$/.test(TEMPLATES[n].label) ? "To the shop" : "To the customer"}</span>
            </a>
          ))}
        </nav>

        <section class="mailstage" aria-label={`Preview: ${TEMPLATES[current].label}`}>
          <div class="mailmeta">
            <dl>
              <dt>Subject</dt><dd>{mail.subject}</dd>
              <dt>Sent</dt><dd>{WHEN[current]}</dd>
            </dl>
          </div>

          <div class="mailtools">
            <div class="seg" role="group" aria-label="Show as">
              <a href={link({ v: "html" })} aria-current={view === "html" ? "true" : undefined}>Email</a>
              <a href={link({ v: "text" })} aria-current={view === "text" ? "true" : undefined}>Plain text</a>
            </div>
            {view === "html" && (
              <div class="seg" role="group" aria-label="Screen width">
                <a href={link({ w: "desktop" })} aria-current={width === "desktop" ? "true" : undefined}>Desktop</a>
                <a href={link({ w: "phone" })} aria-current={width === "phone" ? "true" : undefined}>Phone</a>
              </div>
            )}
            <form method="post" action={link({})} class="sendtest">
              <input name="to" type="email" required placeholder="you@example.com" aria-label="Send a test to" />
              <button class="btn ghost sm" type="submit" disabled={!canSend}>Send me a test</button>
            </form>
          </div>

          {result && <p class={`notice ${resultOk ? "ok" : "warn"}`} role="status">{result}</p>}

          <div class="mailframe" data-w={width}>
            {view === "html" ? (
              <iframe title={`Preview: ${TEMPLATES[current].label}`} srcdoc={mail.html} sandbox="allow-same-origin allow-popups" data-autoheight></iframe>
            ) : (
              <pre class="mailtext">{mail.text}</pre>
            )}
          </div>
        </section>
      </div>
    </div>
  </div>

  <script>
    // Grow the preview to the email's own height, so it reads like an
    // inbox rather than a box with its own scrollbar. The frame may be
    // read from this page (allow-same-origin) but can run no script of
    // its own; if measuring fails, the CSS height stands.
    document.querySelectorAll<HTMLIFrameElement>("iframe[data-autoheight]").forEach((f) => {
      f.addEventListener("load", () => {
        try {
          const h = f.contentDocument?.documentElement.scrollHeight;
          if (h) f.style.height = `${h + 8}px`;
        } catch {
          /* sandboxed: keep the CSS height */
        }
      });
    });
  </script>
</Base>
