---
import Base from "../../layouts/Base.astro";
import { filterRanges, showcaseRanges, MATERIALS, PRICE_TBC } from "../../lib/ranges.ts";
import { getRanges, getSettings } from "../../lib/server/catalogue.ts";
import Swatch from "../../components/Swatch.astro";
import Showcase from "../../components/Showcase.astro";
import { money } from "../../lib/pricing.ts";
import { BUSINESS } from "../../data/business.ts";

// Rendered on demand so the filter really is server-side: the chips
// are plain links, the list is correct with JavaScript switched off,
// and the URL is shareable.
export const prerender = false;

// One material at a time: Carpet (the default), Vinyl or Underlay.
// Accept ?material=carpet as well as ?material=Carpet; anything else
// falls back to carpet.
const rawMaterial = Astro.url.searchParams.get("material") ?? "";
const material = MATERIALS.find((m) => m.toLowerCase() === rawMaterial.toLowerCase()) ?? "Carpet";
const filtered = material !== "Carpet";

const [ranges, settings] = await Promise.all([getRanges(), getSettings()]);
const list = filterRanges(ranges, material, "All");
const showcase = showcaseRanges(ranges);

// Straight to the list, past the banner.
const hrefFor = (value: string) => (value === "Carpet" ? "/ranges/#list" : `/ranges/?material=${value}#list`);

const title = `${material === "Carpet" ? "Carpet" : material} ranges , Quinton Carpets, Birmingham`;

const description =
  "Carpet, vinyl and underlay from our shop on Hagley Road West, Quinton. Guide prices per square metre, supply only , fitting priced separately.";

// Product + Offer for each range on the page. Availability is
// "in stock at the shop", not an online purchase , there is no
// checkout anywhere on this site.
const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: list.map((r, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: r.name,
      url: `${settings.siteUrl}/ranges/${r.id}/`,
      ...(r.brand ? { brand: { "@type": "Brand", name: r.brand } } : {}),
      description: `${r.spec}. ${r.grade}.`,
      category: r.material,
      ...(r.price !== null
        ? {
            offers: {
              "@type": "Offer",
              price: r.price.toFixed(2),
              priceCurrency: "GBP",
              // Per m², supply only , fitting is priced separately.
              unitText: "square metre",
              availability: "https://schema.org/InStoreOnly",
              seller: { "@id": `${settings.siteUrl}/#shop` },
            },
          }
        : {}),
    },
  })),
};
---

<Base
  title={title}
  description={description}
  schema={schema}
  canonicalPath="/ranges/"
  noindex={filtered}
>
  <div class="hero ranges-hero">
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <canvas id="pile" aria-hidden="true"></canvas>
    <!-- No visible heading here; the page still needs one for screen readers and search. -->
    <h1 class="visually-hidden">{material} ranges at Quinton Carpets</h1>
    {showcase.length > 0 && <Showcase showcase={showcase} />}
    <div class="wrap">
      <div class="ranges-intro">
        <p class="lead">
          Hundreds of carpet samples to see and feel in the shop, and vinyl for every room in the house.
        </p>
        <ul class="facts" aria-label="How our prices work">
          <li>Prices per m²</li>
          <li>Supply only</li>
          <li>Fitting priced separately</li>
        </ul>
        <p class="note">So you always know exactly what you're paying for.</p>
      </div>
    </div>
  </div>

  <div class="section plain" id="list">
    <div class="wrap">

      <div class="chips" role="group" aria-label="Filter by material">
        {
          MATERIALS.map((v) => (
            <a
              class="chip"
              href={hrefFor(v)}
              aria-current={material === v ? "true" : undefined}
            >
              {v}
            </a>
          ))
        }
      </div>

      <div class="grid g4">
        {
          list.length === 0 ? (
            <p class="notice info" style="grid-column:1/-1">
              Nothing to show here yet. We carry far more in the shop than we can show
              online , call or pop in.
            </p>
          ) : (
            list.map((r) => (
              // Kept short so the grid reads at a glance: the name, what
              // it's made of, the price, and two equal buttons along the
              // bottom. Features, rooms and colours are on the range page.
              <article class="rangecard">
                <a href={`/ranges/${r.id}/`} tabindex="-1" aria-hidden="true">
                  <Swatch photo={r.photo} alt="" texture={r} tag={r.category ?? r.material} />
                </a>
                <div class="body">
                  <h2 class="rangename"><a class="rangelink" href={`/ranges/${r.id}/`}>{r.name}</a></h2>
                  <p class="meta">{r.spec}</p>
                  <div class="cardfoot">
                    <p class="price">{r.price === null ? <><b>{PRICE_TBC}</b> <small>price coming soon</small></> : <>{r.priceFrom && <small>From </small>}<b>{money(r.price)}</b> /m²</>}</p>
                    <div class="cardbtns">
                      <a class="btn ghost sm" href={`/ranges/${r.id}/`}>View range</a>
                      {r.sampleUrl ? (
                        <a class="btn sm" href={r.sampleUrl} target="_blank" rel="noopener noreferrer">Free sample</a>
                      ) : r.price !== null ? (
                        <a class="btn sm" href={`/estimate/?range=${r.id}`}>Estimate</a>
                      ) : null}
                    </div>
                  </div>
                </div>
              </article>
            ))
          )
        }
      </div>

      <p class="notice info" style="margin-top:26px">
        {
          material === "Underlay" ? (
            <>
              Underlay prices are per square metre, supply only. The right underlay depends on
              the carpet, room and feel you want , call
            </>
          ) : (
            <>
              Carpet prices are Cormar's starting prices per square metre, supply only. Vinyl
              prices are guide prices , call
            </>
          )
        }
        <b style="white-space:nowrap">&nbsp;{BUSINESS.phone}</b>&nbsp;or pop in for today's prices.
      </p>
    </div>
  </div>
</Base>
