---
import Base from "../layouts/Base.astro";
import { floorRanges, underlayRanges } from "../lib/ranges.ts";
import { getRanges, getRates } from "../lib/server/catalogue.ts";
import { swatchStyle } from "../lib/textures.ts";
import { getImage } from "astro:assets";
import { money } from "../lib/pricing.ts";
import { BUSINESS } from "../data/business.ts";

// Rendered on demand, so a price changed in the database is the
// price the customer is quoted.
export const prerender = false;

const [ranges, rates] = await Promise.all([getRanges(), getRates()]);

// Only what the client actually needs, with the swatch already
// painted server-side so the picker is correct before any JS runs.
// The swatch is resolved here, server-side: a photograph when the
// range has one, the CSS texture when it doesn't. The client is
// handed a finished style string either way and never decides.
const floors = await Promise.all(
  floorRanges(ranges).map(async (r) => {
    const photo = r.photo
      ? await getImage({ src: r.photo, width: 320, height: 320, format: "webp", quality: 78 })
      : null;
    return {
      id: r.id,
      name: r.name,
      material: r.material,
      price: r.price,
      priceFrom: r.priceFrom,
      widths: r.material === "Carpet" ? [4, 5] : r.widths,
      hard: r.hard,
      swatch: photo
        ? `background-image:url(${photo.src});background-size:cover;background-position:50% 50%`
        : swatchStyle(r),
    };
  }),
);

const underlays = underlayRanges(ranges).map((r) => ({
  id: r.id,
  name: r.name,
  spec: r.spec,
  price: r.price,
  forHard: r.grade === "For hard floors",
}));

const config = { floors, underlays, rates };

// The shop floor, faded back behind the "book a free measure" band.
const bandPhoto = await getImage({ src: "/site/shop-floor.jpg", width: 1200, height: 800, format: "webp", quality: 72 });
---

<Base
  title="Instant carpet estimate — Quinton Carpets, Birmingham"
  description="Price your rooms in two minutes. We work them against 4m and 5m roll widths the way a fitter does. Guide prices, confirmed on the free measure."
>
  <div class="section plain">
    <div class="wrap">
      <p class="eyebrow">Instant estimate</p>
      <h1 style="font-size:clamp(1.9rem,1.25rem + 2.5vw,3rem); margin-bottom:14px">
        Price your rooms in two minutes.
      </h1>
      <p class="lede" style="margin-bottom:30px">
        Guide prices only. We'll confirm the exact figure on the free measure — carpet is cut
        from 4m and 5m wide rolls, so the true amount depends on how your rooms fall against
        the roll.
      </p>
      <p class="notice info" style="margin-bottom:26px">
        Carpet comes in fixed 4m or 5m roll widths. You cannot choose an arbitrary width because
        carpet is cut from the roll, and the correct roll width helps reduce costly waste. We
        choose the best width automatically from your room measurements, then confirm it during
        the free measure.
      </p>

      <noscript>
        <p class="notice warn" style="margin-bottom:26px">
          The estimator needs JavaScript to do the sums. Ring the shop on
          <b>&nbsp;{BUSINESS.phone}</b>&nbsp;and we'll work it out with you on the phone, or
          <a href="/book/" style="text-decoration:underline">&nbsp;book a free measure</a>.
        </p>
      </noscript>

      <div class="est-layout" id="estimator" data-config={JSON.stringify(config)}>
        <div class="stack" style="gap:22px">
          <div class="panel" data-step="1">
            <div class="head"><span class="n">1</span><h2 style="font-size:1.02rem;font-stretch:112%;font-weight:700">Choose your floor</h2><span class="lockmsg"></span></div>
            <div class="bd">
              <div class="chips floortabs" id="estTabs" role="group" aria-label="Show floors of one kind"></div>
              <div class="floorgrid" id="estRanges"></div>
              <div class="floorpager" id="estPager"></div>
              <div class="stepnext"><button class="btn sm" type="button" data-next="2" disabled>Choose a floor to continue</button></div>
            </div>
          </div>

          <div class="panel" data-step="2">
            <div class="head"><span class="n">2</span><h2 style="font-size:1.02rem;font-stretch:112%;font-weight:700">Your rooms</h2><span class="lockmsg">Choose a floor first</span></div>
            <div class="bd">
              <div id="rooms"></div>
              <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:6px">
                <button class="btn ghost sm" type="button" id="addRoom">+ Add a room</button>
                <button class="btn ghost sm" type="button" id="addStairs">+ Add stairs &amp; landing</button>
              </div>
              <p class="notice info" style="margin-top:16px">
                Measure the widest point of the room in each direction, doorways included.
                Round up to the nearest 10cm — it's better to have a little too much than a
                seam you didn't want.
              </p>
              <div class="stepnext"><button class="btn sm" type="button" data-next="3" disabled>Add a size to continue</button></div>
            </div>
          </div>

          <div class="panel" data-step="3">
            <div class="head"><span class="n">3</span><h2 style="font-size:1.02rem;font-stretch:112%;font-weight:700">Underlay</h2><span class="lockmsg">Add your rooms first</span></div>
            <div class="bd">
              <div class="optlist" id="underlayOpts"></div>
              <div class="stepnext"><button class="btn sm" type="button" data-next="4">Continue to fitting →</button></div>
            </div>
          </div>

          <div class="panel" data-step="4">
            <div class="head"><span class="n">4</span><h2 style="font-size:1.02rem;font-stretch:112%;font-weight:700">Fitting &amp; extras</h2><span class="lockmsg">Choose underlay first</span></div>
            <div class="bd stack" style="gap:16px">
              <div class="optlist" id="fitOpts"></div>
              <div class="optlist" id="extraOpts"></div>
              <div class="stepnext"><button class="btn sm" type="button" data-next="5">Continue →</button></div>
            </div>
          </div>

          <div class="panel" data-step="5">
            <div class="head"><span class="n">5</span><h2 style="font-size:1.02rem;font-stretch:112%;font-weight:700">Promotion or referral code <small class="opt-tag">optional</small></h2><span class="lockmsg">Choose fitting first</span></div>
            <div class="bd">
              <div class="field" style="margin-bottom:10px">
                <label for="promo">Got a code?</label>
                <div class="codebox">
                  <input id="promo" placeholder="QC-REF-7T4M" autocomplete="off" spellcheck="false" />
                  <button class="btn sm" type="button" id="applyPromo">Apply</button>
                </div>
                <p class="hint">
                  A friend's referral code takes 10% off your fitting. Seasonal promotions are
                  announced in the shop window and on Facebook.
                </p>
              </div>
              <div id="promoMsg" role="status" aria-live="polite"></div>
            </div>
          </div>
        </div>

        <aside class="summary" aria-label="Your estimate">
          <div class="top">
            <div class="k">Estimated total</div>
            <div class="v" id="estTotal">£—<small> incl. VAT</small></div>
          </div>
          <div class="lines" id="estLines" aria-live="polite"></div>
          <div style="padding:4px 18px 18px" class="stack" id="estFoot"></div>
        </aside>
      </div>

      <p class="notice info" style="margin-top:26px">
        Fitting is charged at {money(rates.fitCarpet)}/m² for carpet and{" "}
        {money(rates.fitHard)}/m² for laminate and LVT, and stairs are{" "}
        {money(rates.fitStair)} a step. These are guide rates — the figure on the free
        measure is the one that counts.
      </p>
    </div>
  </div>

  <div class="section plain bookband">
    <img class="bookband-photo" src={bandPhoto.src} alt="" loading="lazy" decoding="async" />
    <div class="wrap">
      <div>
        <p class="eyebrow">Next step</p>
        <h2>Happy with the number? Book a free measure.</h2>
        <p>We come to you, measure properly and give you the exact figure in writing. It costs nothing and commits you to nothing.</p>
      </div>
      <a class="btn yellow" href="/book/" data-book>Book a free measure</a>
    </div>
  </div>

  <script>
    import "../scripts/estimator.ts";
  </script>
</Base>
