---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import WorkGallery from "../components/WorkGallery.astro";
import { getSettings } from "../lib/server/catalogue.ts";
import { QUOTES } from "../data/quotes.ts";
import { BUSINESS, SUPPLIERS } from "../data/business.ts";

// Rendered on demand: the photos come from the database.
export const prerender = false;

const settings = await getSettings();

// The work gallery. Stock photographs of carpeted homes, in public/work/,
// until the shop's own job photos are in: five from Unsplash (Unsplash
// licence) and the stairs from Wikimedia Commons (CC0, Warren LeMay), so
// none needs a credit. Swap the files and alt text here; width and
// height are each file's own size.
const GALLERY = [
  { src: "/work/living-room-carpet.jpg", width: 1600, height: 1067, alt: "Open-plan living room with wall-to-wall beige carpet" },
  { src: "/work/carpeted-stairs.jpg", width: 1200, height: 1600, alt: "Staircase fitted with grey carpet on every tread and riser" },
  { src: "/work/bedroom-rug.jpg", width: 1600, height: 1600, alt: "Warm bedroom with a soft rug at the foot of the bed" },
  { src: "/work/lounge-rug.jpg", width: 1600, height: 900, alt: "Beige living room with a large rug under the coffee table" },
  { src: "/work/cream-lounge.jpg", width: 1600, height: 1172, alt: "Cream lounge with a deep-pile rug" },
  { src: "/work/family-room.jpg", width: 1600, height: 844, alt: "Family room with a large rug in front of the sofa" },
];

const STEPS = [
  { n: "STEP 01", h: "Price it online", p: "Pick a range, put your room sizes in and add underlay and fitting. You get an itemised estimate and a reference code in about two minutes." },
  { n: "STEP 02", h: "Book a free measure", p: "Choose a day and a time window. Booking costs nothing and commits you to nothing — we ring you back within one working day." },
  { n: "STEP 03", h: "Choose in the shop", p: "We measure up, then you see and feel the real thing on Hagley Road West and confirm the final price. Payment is taken in the shop, never online." },
  { n: "STEP 04", h: "Our team fits it", p: "Old flooring lifted and taken away, gripper and door bars fitted, everything hoovered before we leave. Then your referral code goes live." },
];
---

<Base
  title="Quinton Carpets — carpets, laminate and vinyl in Quinton, Birmingham"
  description="Birmingham's favourite carpet shop, on Hagley Road West in Quinton. Hundreds of samples, our own fitters, a free measure and an instant online estimate."
>
  <Hero />
  <Ticker />

  <!-- about the shop: the owner's own words -->
  <div class="section plain about-section">
    <div class="wrap">
      <div class="about-grid rv">
        <div class="about-photo">
          {
            settings.aboutPhoto ? (
              <>
                <img src={settings.aboutPhoto} alt="Aman, owner of Quinton Carpets" loading="lazy" />
                <span class="about-tag" aria-hidden="true"><b>Aman</b>Owner, Quinton Carpets</span>
              </>
            ) : (
              <div class="about-card" aria-hidden="true">
                <span class="k">Family run since</span>
                <b>{BUSINESS.founded}</b>
                <span class="k">Family prices · family service</span>
              </div>
            )
          }
        </div>
        <div class="about-copy">
          <p class="eyebrow">About Us</p>
          <h2>Hi, I'm Aman, owner of Quinton Carpets.</h2>
          <p class="lede">
            I run the shop with my brother. We've been Birmingham's local carpet and flooring
            business since {BUSINESS.founded}, and our motto hasn't changed:
          </p>
          <ul class="about-motto">
            <li>Family run</li>
            <li>Family prices</li>
            <li>Family service</li>
          </ul>
          <p>
            As a dad of two, I know what families need from a floor, and from a budget. I'll
            measure, fit or give you honest advice myself, at an honest price. <strong>We will do it right.</strong>
          </p>
          <a class="about-more" href="#reviews">Read what our customers say</a>
        </div>
      </div>
    </div>
  </div>

  <!-- suppliers: a moving band, like the ticker. The first copy is
       the real list; the second only closes the loop, so it is hidden
       from screen readers. -->
  <section class="partner-bar" aria-labelledby="partners-title">
    <h2 class="partner-title" id="partners-title">Our trusted partners</h2>
    <div class="partner-track">
      {[0, 1].map((copy) => (
        <ul class="partner-logos" aria-hidden={copy === 1 ? "true" : undefined}>
          {SUPPLIERS.map((s) => (
            <li class={`partner-logo ${s.id}`} aria-label={copy === 0 ? s.name : undefined}>
              {s.id === "cormar" && <span aria-hidden="true">CORMAR<small>CARPET CO</small></span>}
              {s.id === "kingsmead" && <span aria-hidden="true">KINGSMEAD<small>CARPETS</small></span>}
              {s.id === "regency" && <span aria-hidden="true"><b>R</b><span>REGENCY<br />CARPETS</span></span>}
              {s.id === "lifestyle" && <span aria-hidden="true">lifestyle<small>FLOORS</small></span>}
              {s.id === "cloud" && <span aria-hidden="true">CLOUD<b>9</b></span>}
              {s.id === "cfs" && <span aria-hidden="true">◆<small>CFS</small></span>}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- work gallery -->
  <div class="section plain work-section">
    <div class="wrap">
      <p class="eyebrow rv">Our work</p>
      <h2 class="rv" style="margin-bottom:12px">Some of our work.</h2>
      <p class="lede rv" style="margin-bottom:30px">
        From a single bedroom to a full house, our own fitters take care of the details from
        preparation through to the final clean-up.
      </p>
      <WorkGallery photos={GALLERY} />
    </div>
  </div>

  <!-- how it works -->
  <div class="section">
    <div class="wrap">
      <div class="steps-head">
        <p class="eyebrow">From first look to fitted</p>
        <h2>Four steps, in this order.</h2>
        <p class="lede">
          Every step before the fitting is free. You only pay once you've chosen, in the shop.
        </p>
      </div>
      <div class="steps">
        {
          STEPS.map((s) => (
            <div class="step">
              <span class="n">{s.n}</span>
              <h4>{s.h}</h4>
              <p>{s.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- testimonials -->
  <div class="section" id="reviews">
    <div class="wrap">
      <p class="eyebrow rv">What Birmingham says</p>
      <h2 class="rv" style="margin-bottom:10px">Reviews from Google, Yell, Facebook and Yelp.</h2>
      <p class="lede rv" style="margin-bottom:32px">
        Every word below was written by a real customer on a public review site. Nothing has
        been edited.
      </p>
      <div class="cols rv">
        {
          QUOTES.map((q) => (
            <figure class="quote">
              <div class="stars" role="img" aria-label="5 out of 5">
                {
                  Array.from({ length: 5 }).map(() => (
                    <svg viewBox="0 0 16 16" fill="#FFC61A" stroke="#15120C" stroke-width=".8" aria-hidden="true">
                      <path d="m8 1 2 4.4 4.8.5-3.6 3.2 1 4.7L8 11.4 3.8 13.8l1-4.7L1.2 5.9 6 5.4Z" />
                    </svg>
                  ))
                }
              </div>
              <p style="margin-top:10px">“{q.t}”</p>
              <figcaption class="who"><b>{q.n}</b> · {q.s}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="review-strip rv">
        <div class="review-score" aria-label="Five star Google reviews">
          <span class="review-stars" aria-hidden="true">★★★★★</span>
          <strong>Real reviews from real customers</strong>
          <small>Read the latest reviews on Google</small>
        </div>
        <div class="review-actions">
          <a class="btn ghost sm" href={BUSINESS.mapsUrl} target="_blank" rel="noopener noreferrer">Read our Google reviews</a>
          <a class="btn yellow sm" href={BUSINESS.reviewUrl} target="_blank" rel="noopener noreferrer">Leave a review</a>
        </div>
      </div>
    </div>
  </div>
</Base>
