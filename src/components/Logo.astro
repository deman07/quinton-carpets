---
// The shop's logo, traced from the artwork (public/logo.svg is the same
// drawing in fixed colours). The lettering takes the text colour, so it
// reads on light and dark grounds; the carpet roll is always gold.
interface Props {
  class?: string;
  /** Names it for screen readers; leave it out where the link around it already does. */
  label?: string;
}
const { class: className, label } = Astro.props;
