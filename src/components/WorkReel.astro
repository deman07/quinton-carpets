---
import { getImage } from "astro:assets";
import { SLICES, SPEED, shapeFor, measure, reelVars, keyframes } from "../lib/reel.ts";

interface Props {
  work: { title: string; image: string; alt: string }[];
}
const { work } = Astro.props;

// Square sources; the tiles crop them to 4:3.
const photos = await Promise.all(
  work.map(async (w) => ({
    title: w.title,
    src: (await getImage({ src: w.image, width: 800, height: 800, format: "webp", quality: 78 })).src,
  })),
);

// The first frame is painted at a typical desktop size, so the reel
// is right before any script runs; scripts/reel.ts then re-measures.
const shape = shapeFor(1280);
const reel = measure(1280, 430, shape);
const vars = Object.entries(reelVars(shape, reel))
  .map(([k, v]) => `${k}:${v}`)
  .join(";");
---

<div class="reel rv" id="reel" style={vars} data-work={JSON.stringify(photos)}>
  <style is:inline id="reelTurn" set:html={keyframes(shape, reel)}></style>
  <!-- Every photo is drawn once per slice, so the stage is hidden
       from screen readers; the list under it names each one once. -->
  <div class="reel-stage" aria-hidden="true">
    {
      Array.from({ length: reel.columns }, (_, x) => {
        const p = photos[(reel.columns - 1 - x) % photos.length]!;
        return (
          <div class="reel-col" style={`animation-delay:${-x * SPEED}s`}>
            {Array.from({ length: SLICES }, (_, s) => (
              <div class="reel-slice" style={`--s:${s}`}>
                <div class="reel-face">
                  <img src={p.src} alt="" draggable="false" loading="lazy" />
                  <span>{p.title}</span>
                </div>
              </div>
            ))}
          </div>
        );
      })
    }
  </div>
  <ul class="visually-hidden">
    {work.map((w) => <li>{w.alt}</li>)}
  </ul>
</div>

<script>
  import "../scripts/reel.ts";
</script>
