---
import { getImage } from "astro:assets";
// The home banner: the headline, the two ways in, and a carpet
// sample hanging beside them (scripts/cloth.ts). The animated room
// lives on the ranges page (Showcase.astro).

// The sample on the hanger. Any square range photo works.
const SAMPLE = { name: "Bartley Berber", photo: "/ranges/bartley-berber.jpg" };
const photo = await getImage({ src: SAMPLE.photo, width: 1024, height: 1024, format: "webp", quality: 80 });
---

<div class="hero">
  <!-- layer 1: ambient glow -->
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
  <!-- layer 2: carpet-pile canvas, painted by scripts/pile.ts -->
  <canvas id="pile" aria-hidden="true"></canvas>

  <!-- layer 3: content -->
  <div class="wrap hero-inner hero-split">
    <div class="hero-copy">
      <p class="pill"><span class="dot"></span><span><span class="pill-street">Hagley Road West · </span>Quinton · B32 · open 7 days</span></p>

      <h1 data-words>When it comes to carpets, we're <em class="shine">on a roll.</em></h1>

      <p class="lede hero-sub">
        Birmingham's favourite carpet shop. Hundreds of samples to look at and feel, honest
        prices, and our own fitting team — now with an instant online estimate before you even
        leave the house.
      </p>

      <div class="hero-cta">
        <a class="btn yellow magnet" href="/estimate/">
          Get an instant estimate
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg>
        </a>
        <a class="btn ghost magnet" href="/ranges/">Browse the ranges</a>
      </div>
    </div>

    <!-- layer 4: the hanging sample; beside the copy on wide screens,
         between the headline and the buttons on narrow ones -->
    <div class="hero-cloth" aria-hidden="true">
      <canvas id="cloth" data-photo={photo.src} data-name={SAMPLE.name}></canvas>
    </div>
  </div>
</div>

<script>
  import "../scripts/cloth.ts";
</script>
