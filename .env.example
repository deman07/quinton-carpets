# Copy this file to .env for local development. Never commit .env.
# In production these are set in the Vercel dashboard:
#   Project → Settings → Environment Variables

# ---- The database (required) ----
# Supabase dashboard → Connect → Connection string → Transaction pooler.
# Use the POOLER string (port 6543), not the direct connection: serverless
# functions open and drop connections constantly and the pooler is what
# stops that exhausting the database.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- The first login to the diary at /admin/ (required once) ----
# While nobody is in the staff table, logging in with these makes the
# owner's account. After that they do nothing: add and remove people on
# the diary's Staff page. ADMIN_USER is lower case, no spaces.
ADMIN_USER=
ADMIN_PASSWORD=

# ---- The daily job (required in production) ----
# Vercel Cron calls /api/cron/daily with this as a bearer token. It
# sends the day-before reminders and tidies up. Any long random string.
CRON_SECRET=

# ---- Email (optional) ----
# Resend API key for every email the site sends. Leave it unset and
# bookings still save — the emails are simply skipped and the server logs
# that it skipped them. A mail provider having a bad morning must never
# lose someone's booking.
RESEND_API_KEY=

# Where the shop's copy of each booking goes, and the verified sender
# on the shop's own domain. shop_email and mail_from in the settings
# table win over these when they are filled in.
SHOP_EMAIL=quintoncarpets@gmail.com

MAIL_FROM=Quinton Carpets <bookings@quintoncarpets.co.uk>
